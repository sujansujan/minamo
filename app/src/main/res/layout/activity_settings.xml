<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ascii_bg"
    android:orientation="vertical">

    <!-- Path-style screen header (~/minamo) with hairline below -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/textHeaderPath"
            style="@style/AsciiText.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="~/minamo/pond"
            android:textColor="@color/ascii_accent2" />

        <TextView
            android:id="@+id/textHeaderClockTag"
            style="@style/AsciiText.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[live clock]"
            android:textColor="@color/ascii_accent3" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ascii_border" />

    <!-- Inline undo / status banner (hidden unless triggered) -->
    <LinearLayout
        android:id="@+id/bannerUndo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ascii_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/textUndoMessage"
            style="@style/AsciiText.Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ok: settings reset to defaults."
            android:textColor="@color/ascii_good" />

        <TextView
            android:id="@+id/btnUndoReset"
            style="@style/AsciiText.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="[ undo ]"
            android:textColor="@color/ascii_accent" />
    </LinearLayout>

    <!-- =================================================================== -->
    <!-- SCREEN 1: [1 pond] Live Split-View ASCII Aquarium & Quick Actions   -->
    <!-- =================================================================== -->
    <LinearLayout
        android:id="@+id/screenPond"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Titled AsciiBox framing the live ASCII split-view aquarium -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_ascii_box"
                android:orientation="vertical"
                android:padding="2dp">

                <com.example.koipond.AsciiPondView
                    android:id="@+id/asciiPondView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Interactive split-view ASCII aquarium. Tap water to spawn ripples." />
            </LinearLayout>

            <TextView
                android:id="@+id/textPondBoxTitle"
                style="@style/AsciiText.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@color/ascii_bg"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text=" split-view: over / under "
                android:textColor="@color/ascii_accent2" />
        </FrameLayout>

        <!-- Key/Value status line for active fish biome -->
        <TextView
            android:id="@+id/textBiomeStatus"
            style="@style/AsciiText.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="biome .. clownfish, kohaku koi, neon tetra"
            android:textColor="@color/ascii_dim" />

        <!-- Time-of-day quick cycle selector row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/AsciiText.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="sky: "
                    android:textColor="@color/ascii_dim" />

                <TextView
                    android:id="@+id/btnCycleAuto"
                    style="@style/AsciiText.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="(*) clock" />

                <TextView
                    android:id="@+id/btnCycleDawn"
                    style="@style/AsciiText.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="( ) dawn" />

                <TextView
                    android:id="@+id/btnCycleNoon"
                    style="@style/AsciiText.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="( ) noon" />

                <TextView
                    android:id="@+id/btnCycleDusk"
                    style="@style/AsciiText.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="( ) dusk" />

                <TextView
                    android:id="@+id/btnCycleNight"
                    style="@style/AsciiText.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="( ) night" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Bottom thumb-reachable primary & secondary action row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnShuffleFish"
                style="@style/AsciiText.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/action_shuffle_fish"
                android:textColor="@color/ascii_fg" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnSetWallpaper"
                style="@style/AsciiText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/action_set_wallpaper"
                android:textColor="@color/ascii_accent" />
        </LinearLayout>
    </LinearLayout>

    <!-- =================================================================== -->
    <!-- SCREEN 2: [2 set] Character-Built Configuration Controls            -->
    <!-- =================================================================== -->
    <ScrollView
        android:id="@+id/screenSettings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Panel 1: App Theme & Time Cycle -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_ascii_box"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        style="@style/AsciiText.Small"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ui theme (lagoon light + dark):"
                        android:textColor="@color/ascii_dim" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnThemeSystem"
                            style="@style/AsciiText.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:gravity="center_vertical"
                            android:text="(*) system" />

                        <TextView
                            android:id="@+id/btnThemeLight"
                            style="@style/AsciiText.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:gravity="center_vertical"
                            android:text="( ) light" />

                        <TextView
                            android:id="@+id/btnThemeDark"
                            style="@style/AsciiText.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:gravity="center_vertical"
                            android:text="( ) dark" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/AsciiText.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@color/ascii_bg"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text=" appearance "
                    android:textColor="@color/ascii_accent2" />
            </FrameLayout>

            <!-- Panel 2: Pond Parameters (ASCII progress bars & character steppers) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_ascii_box"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp">

                    <!-- Fish count stepper -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textFishBar"
                            style="@style/AsciiText.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="fish: [#####----] 5" />

                        <TextView
                            android:id="@+id/btnFishMinus"
                            style="@style/AsciiText.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:gravity="center"
                            android:text="[ - ]" />

                        <TextView
                            android:id="@+id/btnFishPlus"
                            style="@style/AsciiText.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:gravity="center"
                            android:text="[ + ]" />
                    </LinearLayout>

                    <!-- Water clarity stepper -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textClarityBar"
                            style="@style/AsciiText.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="rays: [########--] 85%" />

                        <TextView
                            android:id="@+id/btnClarityMinus"
                            style="@style/AsciiText.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:gravity="center"
                            android:text="[ - ]" />

                        <TextView
                            android:id="@+id/btnClarityPlus"
                            style="@style/AsciiText.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:gravity="center"
                            android:text="[ + ]" />
                    </LinearLayout>

                    <!-- Grid density radio -->
                    <TextView
                        style="@style/AsciiText.Small"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="character grid density:"
                        android:textColor="@color/ascii_dim" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnGridCozy"
                            style="@style/AsciiText.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:gravity="center_vertical"
                            android:text="( ) 38c" />

                        <TextView
                            android:id="@+id/btnGridBalanced"
                            style="@style/AsciiText.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:gravity="center_vertical"
                            android:text="(*) 46c" />

                        <TextView
                            android:id="@+id/btnGridDense"
                            style="@style/AsciiText.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:gravity="center_vertical"
                            android:text="( ) 56c" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/AsciiText.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@color/ascii_bg"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text=" aquarium grid "
                    android:textColor="@color/ascii_accent2" />
            </FrameLayout>

            <!-- Panel 3: Engine & Sensors -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_ascii_box"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/AsciiText.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="frame rate cap" />

                        <TextView
                            android:id="@+id/btnFps30"
                            style="@style/AsciiText.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:gravity="center"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="(*) 30fps" />

                        <TextView
                            android:id="@+id/btnFps60"
                            style="@style/AsciiText.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:gravity="center"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="( ) 60fps" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowGyroSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/AsciiText.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="gyroscope tilt parallax" />

                        <TextView
                            android:id="@+id/textGyroSwitch"
                            style="@style/AsciiText.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="[ on]"
                            android:textColor="@color/ascii_accent" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/AsciiText.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@color/ascii_bg"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text=" performance "
                    android:textColor="@color/ascii_accent2" />
            </FrameLayout>

            <!-- Destructive action with inline undo -->
            <TextView
                android:id="@+id/btnResetDefaults"
                style="@style/AsciiText.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:text="@string/action_reset_defaults"
                android:textColor="@color/ascii_dim" />
        </LinearLayout>
    </ScrollView>

    <!-- =================================================================== -->
    <!-- SCREEN 3: [3 about] Tagline, Species Catalog & Dynamic Time Table   -->
    <!-- =================================================================== -->
    <ScrollView
        android:id="@+id/screenAbout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_ascii_box"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        style="@style/AsciiText.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="minamo v2.0.0"
                        android:textColor="@color/ascii_accent2" />

                    <TextView
                        style="@style/AsciiText.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/tagline" />

                    <TextView
                        style="@style/AsciiText.Small"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="unlock behavior .... randomizes species
time cycle ......... dawn / noon / dusk / night
view mode .......... split over-water &amp; under"
                        android:textColor="@color/ascii_dim" />
                </LinearLayout>

                <TextView
                    style="@style/AsciiText.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@color/ascii_bg"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text=" about "
                    android:textColor="@color/ascii_accent2" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_ascii_box"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        style="@style/AsciiText.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="neon tetra ......... &gt;&lt;&gt;°
silver minnow ...... &gt;-))°&gt;
clownfish .......... &gt;))|°&gt;
blue tang .......... &gt;==))°&gt;
gold ogon .......... &gt;)))'&gt;
mandarin ........... &gt;~#°&gt;
kohaku koi ......... &gt;&lt;(((º&gt;
moorish idol ....... &gt;||°&gt;
veil betta ......... &gt;)))º&gt;" />
                </LinearLayout>

                <TextView
                    style="@style/AsciiText.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@color/ascii_bg"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text=" species catalog "
                    android:textColor="@color/ascii_accent2" />
            </FrameLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar: 3 character-built destinations -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ascii_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ascii_surface"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/navPond"
            style="@style/AsciiText.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:gravity="center"
            android:text="@string/nav_pond" />

        <TextView
            android:id="@+id/navSet"
            style="@style/AsciiText.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:gravity="center"
            android:text="@string/nav_set" />

        <TextView
            android:id="@+id/navAbout"
            style="@style/AsciiText.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:gravity="center"
            android:text="@string/nav_about" />
    </LinearLayout>

</LinearLayout>
