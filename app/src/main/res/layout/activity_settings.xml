<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:layout_marginBottom="12dp" />

        <android.opengl.GLSurfaceView
            android:id="@+id/glPreviewSurface"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/buttonApplyWallpaper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/apply_wallpaper"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/textFishCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <SeekBar
            android:id="@+id/seekFishCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/textWaterClarity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <SeekBar
            android:id="@+id/seekWaterClarity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/textSunAngle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <SeekBar
            android:id="@+id/seekSunAngle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_fps_cap"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/radioGroupFps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <RadioButton
                android:id="@+id/radioFps30"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fps_30" />

            <RadioButton
                android:id="@+id/radioFps60"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fps_60" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_quality_preset"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/radioGroupPreset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <RadioButton
                android:id="@+id/radioPresetLow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/preset_low" />

            <RadioButton
                android:id="@+id/radioPresetBalanced"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/preset_balanced" />

            <RadioButton
                android:id="@+id/radioPresetUltra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/preset_ultra" />
        </RadioGroup>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchGyro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_gyro_parallax"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

    </LinearLayout>
</ScrollView>
