<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Minamo.Ascii" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/ascii_bg</item>
        <item name="android:colorBackground">@color/ascii_bg</item>
        <item name="colorSurface">@color/ascii_surface</item>
        <item name="colorOnBackground">@color/ascii_fg</item>
        <item name="colorOnSurface">@color/ascii_fg</item>
        <item name="colorPrimary">@color/ascii_accent</item>
        <item name="colorSecondary">@color/ascii_accent2</item>
        <item name="colorTertiary">@color/ascii_accent3</item>
        <item name="colorError">@color/ascii_error</item>
        <item name="android:fontFamily">@font/ascii_mono</item>
        <item name="fontFamily">@font/ascii_mono</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorControlHighlight">@android:color/transparent</item>
    </style>

    <style name="AsciiText.Body" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/ascii_mono</item>
        <item name="fontFamily">@font/ascii_mono</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3sp</item>
        <item name="android:textColor">@color/ascii_fg</item>
        <item name="android:fontFeatureSettings">liga 0, calt 0</item>
    </style>

    <style name="AsciiText.Title" parent="AsciiText.Body">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AsciiText.Small" parent="AsciiText.Body">
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">2sp</item>
    </style>
</resources>
